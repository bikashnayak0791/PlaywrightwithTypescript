{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "types": ["@playwright/test", "node"],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "pages/**/*",
    "utils/**/*",
    "step-definitions/**/*",
    "types/**/*",
    "features/**/*"
, "TestData/TestData.ts"  ],
  "exclude": [
    "node_modules",
    "dist",
    "reports",
    "cucumber-report"
  ]
}
